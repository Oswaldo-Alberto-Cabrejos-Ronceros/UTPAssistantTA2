# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO — UTP ASSISTANT
# ==============================================================================

# 1. GOOGLE GEMINI API (Obligatorio para llamadas reales de IA y Function Calling)
# Obtén tu API Key gratuita en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
# Versión actual de Gemini (Recomendado: gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-3.6-flash

# 2. ATLASSIAN JIRA CLOUD (Opcional - Si no se configura, activa Simulación Fallback)
# URL de tu instancia Jira Cloud (ej. https://miempresa.atlassian.net)
JIRA_URL=https://tu-dominio.atlassian.net
# Correo de tu cuenta Atlassian
JIRA_EMAIL=tu_correo@utp.edu.pe
# Token de API generado en: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=tu_token_de_jira_aqui
# Clave del proyecto en Jira donde se crearán los tickets (ej. PAYMOD, UTP, KAN)
JIRA_PROJECT_KEY=UTPCONSULT

# 3. GOOGLE CALENDAR API (Opcional - Si no se configura, activa Simulación Fallback)
# ID del calendario (generalmente 'primary' o tu correo Gmail/Google Workspace)
GOOGLE_CALENDAR_ID=primary

# --- OPCIÓN 2: JSON INLINE COMO BASE64 (RECOMENDADO POR TI) ---
# Genera el Base64 de tu archivo service_account.json:
# En Windows PowerShell:
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("service_account.json")) | Set-Clipboard
# En Linux/macOS:
#   base64 -w 0 service_account.json
# Pega el string resultante aquí:
GOOGLE_SERVICE_ACCOUNT_B64="tu_service_account_en_base64_aqui"

# --- OPCIÓN 1 (Alternativa): Ruta al archivo JSON ---
# GOOGLE_APPLICATION_CREDENTIALS=service_account.json
# GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# 4. CRM CORPORATIVO (Por diseño del proyecto, opera en Modo Simulado en memoria)
# No requiere credenciales externas.