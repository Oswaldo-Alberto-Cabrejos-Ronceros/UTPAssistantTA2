# ==============================================================================
# VARIABLES DE ENTORNO — UTP ASSISTANT
# ==============================================================================

# 1. GOOGLE GEMINI API
# Clave de API de Google Gemini (Google AI Studio)
GEMINI_API_KEY=AIzaSy_clave_api
# Modelo generativo de Google Gemini
GEMINI_MODEL=gemini-3.6-flash

# 2. ATLASSIAN JIRA CLOUD
# URL base de la instancia de Jira Cloud
JIRA_URL=https://dominio.atlassian.net
# Correo electrónico de la cuenta de Atlassian
JIRA_EMAIL=correo@utp.edu.pe
# Token de autenticación de Atlassian Jira
JIRA_API_TOKEN=token_api_jira
# Clave del proyecto en Jira
JIRA_PROJECT_KEY=UTPCONSULT

# 3. GOOGLE CALENDAR API
# Identificador del calendario destino (correo electrónico o 'primary')
GOOGLE_CALENDAR_ID=primary
# Credenciales de Service Account en formato Base64
GOOGLE_SERVICE_ACCOUNT_B64=""
# Ruta alternativa al archivo de credenciales JSON
# GOOGLE_APPLICATION_CREDENTIALS=service_account.json
# GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# 4. CRM CORPORATIVO
# Almacenamiento simulado en memoria para el pipeline de ventas